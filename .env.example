# FarmMeasure — local + deploy template. Copy to .env (gitignored, never commit).
#
# LOCAL DEV (one step):
#   1. cp .env.example .env   (or copy the file manually on Windows)
#   2. Put your ROTATED MapTiler key in MAPTILER_KEY below.
#   3. Run: npm run key:local   → generates js/secrets.js (gitignored).
#   4. Run: npm run serve        → open http://localhost:8765
#
# DEPLOYS (GitHub → Cloudflare Pages and/or AWS Amplify):
#   Do NOT put keys in git. Set MAPTILER_KEY in each hosting dashboard
#   (per environment: Production + Preview). The build runs
#   `npm run build` (scripts/inject-key.js) which replaces the
#   __MAPTILER_KEY__ placeholder in js/config.js. Same key name on both
#   providers, so one repo works for both.
#
# At ship, rotate keys and switch to per-environment referrer-locked
# tokens in the MapTiler dashboard (one per domain).

# Your rotated MapTiler key — local dev only, never committed.
MAPTILER_KEY=__MAPTILER_KEY__

# Local test server ports — dev (:8765) and isolated test (:8766) never clash.
TEST_PORT=8765
TEST_STAGING_PORT=8766
